# --- Databricks SQL warehouse (ingest + Text2SQL execution) ---
# Connection details tab on the warehouse. Do NOT use an all-purpose cluster.
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR_WAREHOUSE_ID
DATABRICKS_TOKEN=dapi...
# Catalog you can CREATE SCHEMA / TABLE in. Creating a new catalog needs
# metastore admin; otherwise set an existing catalog you own.
DATABRICKS_CATALOG=neocarta_demo

# --- Neo4j (AuraDB) ---
# Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://YOUR_AURA_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD
NEO4J_DATABASE=neo4j

# --- LLM & embeddings ---
OPENAI_API_KEY=sk-...your-key-here...
# Optional — enables Anthropic models in the agent menu / sweep
ANTHROPIC_API_KEY=

AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
# No OpenAI account? Serve embeddings locally (768-dim, matches the index):
#   uv run python src/local_embeddings.py
# EMBEDDING_MODEL=openai/all-mpnet-base-v2
# EMBEDDING_API_BASE=http://127.0.0.1:8876/v1

# --- Benchmark knobs ---
# MODELS=gpt-4o-mini,gpt-4o
# MONTHLY_QUERIES=10000
# RECURSION_LIMIT=40
# COMPACT_MAX_TABLES=3
# COMPACT_DESCRIPTIONS=0
# DEMO_QUIET=1
# DEMO_STDERR_LOG=/tmp/databricks_neocarta_agent.stderr.log
